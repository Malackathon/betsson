# Copia este archivo a .env (ya está en .gitignore). NUNCA subas valores reales.
#
# Cuatro cuentas, una por (mercado, escenario). Cada escenario usa SU PROPIA cuenta,
# así los 4 casos pueden correr a la vez sin pisarse la sesión.
#   S1 = cuenta CON fondos    -> Escenario 1 (giro completado)
#   S2 = cuenta SIN fondos    -> Escenario 2 (saldo insuficiente)

GEMINI_API_KEY=

# --- Mercado .com (inglés, EUR) ---
BETSSON_COM_S1_USER=
BETSSON_COM_S1_PASS=
BETSSON_COM_S2_USER=
BETSSON_COM_S2_PASS=

# --- Mercado .pe (español, PEN) ---
BETSSON_PE_S1_USER=
BETSSON_PE_S1_PASS=
BETSSON_PE_S2_USER=
BETSSON_PE_S2_PASS=

# --- Opcionales ---
HEADLESS=true
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
